# Copy to .env on the VPS, fill with staging-only values, and chmod 600.
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
UPLOADS_PATH=/opt/rasheepharma/staging/uploads

# SQL Server Express hosted on the VPS, bound to Docker bridge only.
ConnectionStrings__DefaultConnection=Server=172.18.0.1,1433;Database=RashePharmaStaging;User Id=CHANGE_ME;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# Generate a unique random signing key for staging (at least 32 bytes).
JWT__KEY=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
Stripe__SecretKey=CHANGE_ME_STAGING_STRIPE_SECRET
Stripe__WebhookSecret=CHANGE_ME_STAGING_STRIPE_WEBHOOK_SECRET
Frontend__BaseUrl=https://staging.rashelifesciences.com
Email__EnquiryRecipient=CHANGE_ME_STAGING_RECIPIENT_EMAIL

Brevo__SmtpHost=smtp-relay.brevo.com
Brevo__SmtpPort=587
Brevo__SmtpUsername=CHANGE_ME
Brevo__SmtpPassword=CHANGE_ME
Brevo__FromEmail=CHANGE_ME
Brevo__FromName=Rashe Pharma Staging

# Existing RabbitMQ service reachable from Docker containers through host gateway.
RabbitMQ__Host=host.docker.internal
RabbitMQ__Port=5672
RabbitMQ__VirtualHost=/
RabbitMQ__Username=CHANGE_ME
RabbitMQ__Password=CHANGE_ME
RabbitMQ__BulkUploadQueueName=rashepharma-staging-bulk-upload
RabbitMQ__DeadLetterExchangeName=rashepharma-staging-bulk-upload.dlx
RabbitMQ__DeadLetterQueueName=rashepharma-staging-bulk-upload.dead-letter

Cors__AllowedOrigins__0=https://staging.rashelifesciences.com
ForwardedHeaders__KnownProxies__0=172.18.0.1
