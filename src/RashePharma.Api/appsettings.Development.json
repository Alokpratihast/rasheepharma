{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureServiceBus": {
    "FullyQualifiedNamespace": "rasheepharma-email-bus.servicebus.windows.net",
    "TransactionalQueueName": "email-transactional",
    "BulkQueueName": "email-bulk",
    "TestQueueName": "email-connectivity-test"
  },
  "OutboxDispatcher": {
  "BatchSize": 20,
  "PollingIntervalSeconds": 5,
  "LeaseDurationSeconds": 60,
  "MaxAttempts": 5,
  "RetryBaseDelaySeconds": 30,
  "RetryMaxDelaySeconds": 3600
}
}