{
  "AzureServiceBus": {
    "TransactionalQueueName": "email-transactional",
    "BulkQueueName": "email-bulk"
  },
  "OutboxDispatcher": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 5,
